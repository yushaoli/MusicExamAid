# Caddyfile vhost snippet for MusicExamAid on xgar.com.cn
#
# Target deployment options:
# 1. On ubtxiaomi (100.64.0.4) via caddy-cloudflare (Cloudflare DNS-01 TLS):
#    Serves https://mea.xgar.com.cn -> MusicExamAid API container/host (:3000)
# 2. On derp-sgr (47.130.165.104 / 100.64.0.1) via Caddy over tailnet -> 100.64.0.4:3000
#    (recommended if public ingress without Cloudflare Tunnel is required for WeChat callbacks)
#
# Exposed routes:
# - /health                 -> API health + Uptime Kuma monitor
# - /webhooks/wechat-mp     -> WeChat Service Account (服务号) server callback
# - /webhooks/wecom         -> WeCom (企业微信) app callback
# - /learners, /registrations, /archives, /exports, /notifications/* -> REST API
# - /MP_verify_*.txt, /WW_verify_*.txt -> Static domain verification files

mea.xgar.com.cn {
	handle /MP_verify_*.txt {
		root * /srv/mea-verify
		file_server
	}

	handle /WW_verify_*.txt {
		root * /srv/mea-verify
		file_server
	}

	handle {
		reverse_proxy 100.64.0.4:3000
	}
}
